APP_NAME=AI Knowledge Assistant
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+asyncpg://rag:replace-with-a-database-password@postgres:5432/rag
REDIS_URL=redis://redis:6379/0

# JSON mapping: API key -> workspace id. Use long random keys in production.
API_KEYS_JSON={"replace-with-a-long-random-key":"demo-workspace"}

# OpenAI-compatible Chat Completions endpoint.
# OpenAI cloud: https://api.openai.com/v1
# llama.cpp on the host: http://host.docker.internal:8080/v1
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=local-not-secret
LLM_MODEL=deepseek
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=700
LLM_TEMPERATURE=0.1

# Multilingual local embedding model (384 dimensions).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

MAX_UPLOAD_BYTES=15728640
MAX_EXTRACTED_CHARACTERS=2000000
CHUNK_SIZE=900
CHUNK_OVERLAP=150
DOCUMENT_INDEXING_MODE=async
DOCUMENT_RAW_TTL_SECONDS=3600
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.15
RAG_HYBRID_SEARCH=true
RAG_KEYWORD_WEIGHT=0.25
RAG_CANDIDATE_MULTIPLIER=4
CHAT_RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_FAIL_OPEN=false
CORS_ORIGINS=[]

# Telegram bot is optional. Keep the token empty to disable it.
TELEGRAM_BOT_TOKEN=
BACKEND_URL=http://api:8000
BACKEND_API_KEY=replace-with-a-long-random-key
# Comma-separated Telegram numeric user IDs. Empty means nobody is allowed.
ALLOWED_TELEGRAM_USER_IDS=
